# Generate unique secrets; never commit the populated .env file.
WATCHDOG_BIND=0.0.0.0
WATCHDOG_PORT=18765
ADMIN_TOKEN=REPLACE_WITH_RANDOM_40_PLUS_CHARACTERS
JOB_INVENTORY_TOKEN=REPLACE_WITH_RANDOM_40_PLUS_CHARACTERS
JOB_REPORT_TOKEN=REPLACE_WITH_RANDOM_40_PLUS_CHARACTERS
# Optional: trusted HTTPS webhook endpoint; never include customer data.
WEBHOOK_URL=

# Retain events and delivered notifications for 90 days; never prune undelivered alerts.
RETENTION_DAYS=90

# Optional alternative notification channel: use webhook (default) or smtp.
# SMTP uses implicit TLS (port 465) and verified server certificates.
# Set SMTP_PASSWORD to a customer-owned provider app password; never commit .env.
NOTIFICATION_CHANNEL=webhook
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
